-- Scripts
local function sellall()
	local args = {
		"SellAll"
	}
	game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("SellItems"):InvokeServer(unpack(args))
end

local function tradeall()
	local args = {
		"TurnInAll"
	}
	game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvents"):WaitForChild("BotanistQuestRequest"):InvokeServer(unpack(args))
end

